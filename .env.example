# Memoria Core v2.0 configuration reference
#
# Copy this file to .env. Docker Compose and ./start.sh both read it.
# Empty optional values are treated as unset and fall back to the defaults
# documented below. Never commit real database passwords or private paths.

# === CRAWL & PATHS ==========================================================
# Native mode reads CRAWL_ROOTS using the host path separator (`:` on Linux/macOS,
# `;` on Windows). Compose binds MEMORIA_MEDIA_PATH read-only and exposes it as
# MEMORIA_CONTAINER_CRAWL_ROOTS inside the Linux container.
# Compose binds an optional browse root read-only at /host for folder-picker scans.
# By default it reuses the safe repo-local ./media directory rather than host /.
# Set this to a narrow parent directory only when you need to browse beyond
# MEMORIA_MEDIA_PATH; avoid mounting an entire drive because resolution is recursive.
# Linux/macOS Docker example: MEMORIA_HOST_MOUNT=/Users/you/Pictures
# Windows Docker Desktop: MEMORIA_HOST_MOUNT=C:/
#   Add extra drives if needed, e.g. MEMORIA_HOST_MOUNT=D:/ with a Compose override.
# MEMORIA_MEDIA_PATH still provides the /media/library alias used by default crawl.
# MEMORIA_LIBRARY_MOUNTS controls where the Settings folder picker searches.
# In Compose, leave it unset to search only /host and /media/library; any
# explicit values must be container paths, not host paths. Native mode defaults
# to platform filesystem roots, so set narrow absolute paths there when desired.
# MEMORIA_LIBRARY_MOUNTS=/host
# CRAWL_ROOTS=/absolute/path/to/your/photos
# MEMORIA_MEDIA_PATH=/absolute/path/to/your/photos
# MEMORIA_HOST_MOUNT=/absolute/photo/parent
MEMORIA_CONTAINER_CRAWL_ROOTS=/media/library
# MEMORIA_MEDIA_READ_ONLY=0

# Writable-state defaults are under ~/.memoria in native mode and are supplied
# as /var/lib/memoria mounts by Compose. Set only when a custom layout is needed.
# MEMORIA_STATE_DIR=/absolute/writable/path/.memoria
# MEMORIA_DATA_DIR=/absolute/writable/path/.memoria/data
# MEMORIA_CACHE_DIR=/absolute/writable/path/.memoria/cache
# MEMORIA_EDITS_DIR=/absolute/writable/path/.memoria/edits
# MEMORIA_TRASH_DIR=/absolute/writable/path/.memoria/trash
# MEMORIA_MODELS_DIR=/absolute/writable/path/.memoria/models
# MEMORIA_METRICS_DIR=/absolute/writable/path/.memoria/metrics
# MEMORIA_SIDECAR_ROOT=/absolute/writable/path/.memoria/sidecars
# MEMORIA_SCAN_INDEX_DB=/absolute/writable/path/.memoria/data/scan_index.db
# HUEY_DB=/absolute/writable/path/.memoria/data/queue.db

# API/web binding. Port 5004 is the standalone Next.js production server.
MEMORIA_BIND_ADDRESS=127.0.0.1
# Native-only per-service overrides; normally inherit MEMORIA_BIND_ADDRESS.
# MEMORIA_API_HOST=127.0.0.1
# MEMORIA_WEB_HOST=127.0.0.1
MEMORIA_API_PORT=8000
MEMORIA_WEB_PORT=5004
ALLOWED_ORIGINS=http://localhost:5004,http://127.0.0.1:5004
# Native mode derives this proxy target from the reachable API bind. Override
# only when the frontend must proxy to a different backend address.
# MEMORIA_INTERNAL_API_URL=http://127.0.0.1:8000
# Build-time browser API override honored by native builds and Compose image
# rebuilds. Leave unset to use the standalone server's same-origin rewrites.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# === DATABASE ===============================================================
# Native mode may use DATABASE_URL directly or construct it from DB_* values.
# Compose overrides DB_HOST with its internal `db` service name and supplies
# working memoria/memoria defaults. Leave these commented for a zero-config
# Compose database; set either DATABASE_URL or DB_* only for native/external DB.
# DATABASE_URL=postgresql://memoria:change-me@localhost:5432/memoria
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=memoria
# Compose requires an explicit unique password on first run. Keep it stable
# for an existing persistent volume; changing it does not rotate PostgreSQL.
DB_PASSWORD=replace-with-a-unique-local-password
# DB_NAME=memoria
MEMORIA_DB_WAIT_SECONDS=90
# Positive integer seconds; also sets the Compose app-health startup grace.
MEMORIA_COMPOSE_WAIT_SECONDS=300

# PostgreSQL/pgvector baseline used by compose.yaml.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_MAINTENANCE_WORK_MEM=256MB
PG_WORK_MEM=16MB
PG_RANDOM_PAGE_COST=4
PG_MAX_PARALLEL_WORKERS_PER_GATHER=2
PG_MAX_WAL_SIZE=1GB
PG_SHM_SIZE=1gb

# === ML MODELS & DIMENSIONS =================================================
# Built-in scene aliases:
#   openclip-vit-l-14                -> 224px, 768 dimensions
#   openclip-siglip-so400m-384       -> 384px, 1152 dimensions
#   hf-siglip2-so400m-384            -> 384px, 1152 dimensions
MEMORIA_SCENE_PROFILE=openclip-vit-l-14
MEMORIA_SCENE_PROVIDERS=auto
MEMORIA_SCENE_PRECISION=auto
MEMORIA_SCENE_AUTO_REINDEX=1
MEMORIA_SCENE_REINDEX_BATCH_SIZE=16

# Advanced descriptor fields. MEMORIA_SCENE_MODEL may select a built-in alias;
# weights/revision/dimension/resolution overrides create a distinct immutable
# identity. A non-built-in model requires a complete compatible descriptor.
# MEMORIA_SCENE_MODEL=ViT-L-14
# MEMORIA_SCENE_DRIVER=open_clip
# MEMORIA_SCENE_WEIGHTS=laion2b_s32b_b82k
# MEMORIA_SCENE_REVISION=
# MEMORIA_SCENE_DIM=768
# MEMORIA_SCENE_INPUT_RESOLUTION=224
# Compatibility aliases accepted by the provider resolver. Prefer the plural
# ordered list above; DEVICE and singular PROVIDER are retained for old setups.
# MEMORIA_SCENE_PROVIDER=cuda
# MEMORIA_SCENE_DEVICE=cuda
# MEMORIA_CLIP_MODEL=ViT-L-14/laion2b_s32b_b82k

# Keep API-side text encoding on CPU by default so it does not duplicate the
# worker's large scene model allocation on the GPU.
MEMORIA_API_ML_DEVICE=cpu

# Face pipeline. TensorRT is opt-in and reports FP16 truthfully when enabled.
MEMORIA_FACE_ENGINE=ensemble-v1
MEMORIA_FACE_DETECTORS=mtcnn,yunet,insightface
MEMORIA_FACE_EMBEDDER=insightface
MEMORIA_FACE_PROVIDER=auto
# MEMORIA_FACE_PROVIDERS=tensorrt,onnx-cuda,cpu
# MEMORIA_FACE_DEVICE=cuda
MEMORIA_FACE_PRECISION=auto
MEMORIA_FACE_MIN_CONSENSUS=2
MEMORIA_FACE_BATCH_CONCURRENCY=2
MEMORIA_FACE_INSIGHTFACE_MODEL=buffalo_l
MEMORIA_INSIGHTFACE_USE_TRT=0

# Optional model locations.
# MEMORIA_DEDUP_MODEL_PATH=/absolute/path/sscd_disc_mixup.torchscript.pt
# MEMORIA_YUNET_MODEL_PATH=/absolute/path/face_detection_yunet_2023mar.onnx

# SSCD near-duplicate grouping. The embedding schema is deliberately fixed at
# 512 dimensions; MEMORIA_DEDUP_DIM is not a supported runtime override.
MEMORIA_DEDUP_THRESHOLD=0.10
MEMORIA_DEDUP_KNN=8
MEMORIA_HNSW_EF_SEARCH=80

# === PIPELINE & MEMORY =======================================================
# The Huey worker count is a memory-safety invariant. Do not increase it.
MEMORIA_HUEY_WORKERS=1
MEMORIA_BATCH_SIZE=16
MEMORIA_CACHE_MAX_GB=10
MEMORIA_RAM_WARN_PCT=0.85
MEMORIA_RAM_CRIT_PCT=0.95
MEMORIA_RAM_FLOOR_PCT=0.90
MEMORIA_GPU_WARN_PCT=0.85
MEMORIA_GPU_CRIT_PCT=0.95
MEMORIA_RESERVED_MB=2048
MEMORIA_MB_PER_ITEM=512
MEMORIA_BREATHE_SLEEP_OK_S=0
MEMORIA_BREATHE_SLEEP_WARN_S=1
MEMORIA_BREATHE_SLEEP_CRIT_S=5
MEMORIA_BLUR_THRESHOLD=0.75
MEMORIA_MAX_DECODE_DIM=4096
MEMORIA_STATS_TTL_S=30
MEMORIA_METRICS_MAX_SERIES=512
MEMORIA_HEARTBEAT_STALE_S=120
MEMORIA_STALL_TASK_S=600
MEMORIA_STALL_NO_COMPLETE_S=900

# === FRONTEND & CONTAINER IDENTITY ==========================================
MEMORIA_FRONTEND_MODE=production
MEMORIA_FRONTEND_REBUILD=auto
MEMORIA_UID=1000
MEMORIA_GID=1000
MEMORIA_IMAGE=memoria-core:local
# MEMORIA_GPU_IMAGE=memoria-core:gpu-local
# MEMORIA_CUDA_VERSION=12.4.1

# Optional GPU-overlay visibility. Compose applies these only with
# compose.gpu.yaml; omit them for CPU deployments.
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=compute,utility

# CPU thread caps prevent image/ML libraries from oversubscribing a deployment.
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
MALLOC_MMAP_THRESHOLD_=33554432
MALLOC_TRIM_THRESHOLD_=134217728

# === BENCHMARK HARNESS ======================================================
# Base API used by `python backend/bench.py ...`.
MEMORIA_API=http://localhost:8000
